{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,scss,md,json}\""
  },
  "prepare": "husky install",
  "lint-staged": {
    "src/**/*.{js,ts,vue,css,scss,md,json}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@wailsio/runtime": "latest",
    "qrcode": "^1.5.4",
    "vue": "^3.2.37"
  },
  "devDependencies": {
    "@babel/types": "^7.18.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.19.130",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "prettier": "^3.9.0",
    "stylelint": "^15.10.0",
    "stylelint-config-standard": "^32.0.0",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  }
}
